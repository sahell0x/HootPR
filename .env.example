# ============ HootPR configuration (copy to .env; `make init` does it and generates secrets) ============
# Every setting HootPR reads. Secrets belong ONLY in .env (gitignored) — never commit them.
# Keep comments on their own lines: an inline "# ..." after an empty value would become the value.
# A clean clone boots with these defaults; sign-in / billing / LLM features need the provider keys below.

# --- core
# development | test | production (production refuses empty secrets)
APP_ENV=development
LOG_LEVEL=INFO
# Ports: this root .env is the single source of truth for docker (`make up`) AND non-docker runs
# (`make dev-api` / `make dev-web`; the backend reads this file from backend/ too).
# dashboard port, published on all interfaces (compose host port / `next dev -p`); keep APP_BASE_URL in sync
WEB_PORT=3000
# API port, published on all interfaces (compose host port / uvicorn --port); keep API_BASE_URL / API_PUBLIC_URL in sync
API_PORT=8000
# The dashboard and the API are SEPARATE origins (each can sit behind its own domain/proxy).
# Defaults follow the ports: http://localhost:${WEB_PORT} and http://localhost:${API_PORT}.
# public URL of the dashboard (post-login redirects, links in PR comments; the only CORS origin)
APP_BASE_URL=http://localhost:3000
# public URL of the API (OAuth callbacks, GitHub App setup URL, webhooks, /schema/*)
API_BASE_URL=http://localhost:8000
# API URL the BROWSER calls (web reads it per request, no rebuild); normally = API_BASE_URL.
# compose default: http://localhost:${API_PORT}
API_PUBLIC_URL=http://localhost:8000
# extra comma-separated origins allowed by CORS besides APP_BASE_URL
CORS_EXTRA_ORIGINS=
# SameSite of the session/CSRF cookies: lax (app/api same-site, e.g. localhost:3000 + :8000 or
# app.example.com + api.example.com) | none (cross-site, e.g. two trycloudflare hosts; forces Secure) | strict
COOKIE_SAMESITE=lax
# optional cookie Domain (e.g. .example.com); empty = host-only on the API host
COOKIE_DOMAIN=
# uvicorn processes in the api container. Each is a separate ~110 MB process: keep 1 unless you
# also raise the api mem_limit (192m) in docker-compose.yml
API_WORKERS=1
# Fernet key: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_ENCRYPTION_KEY=
# any long random string
SESSION_SECRET=
POSTGRES_PASSWORD=hootpr
# compose overrides this from POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://hootpr:hootpr@postgres:5432/hootpr
REDIS_URL=redis://redis:6379/0
# comma-separated provider:username (e.g. github:octocat,gitlab:alice) who may see internal LLM
# cost / tokens / models in the dashboard and API. Everyone else only sees HootPR credits.
PLATFORM_OWNERS=

# --- GitHub App (see README "Create the GitHub App")
GITHUB_APP_ID=
GITHUB_APP_SLUG=hootpr
# put the .pem in ./secrets/github_app.pem
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app.pem
# alternative: the PEM inline with \n escapes
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# the App's Client ID (user authorization)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com
# dev only: `make tunnel` starts two Cloudflare quick tunnels (web + api, no token needed) and writes
# APP_BASE_URL / API_BASE_URL / API_PUBLIC_URL / COOKIE_SAMESITE=none. Optional: a named-tunnel token
# (one hostname → http://web:3000, one → http://api:8000) for stable URLs; then set the URLs yourself.
CLOUDFLARE_TUNNEL_TOKEN=
# dev only (alternative to the tunnel): smee channel for GitHub App webhooks
SMEE_URL=

# --- GitLab (login OAuth app; bot tokens are per org, stored encrypted in the DB)
GITLAB_BASE_URL=https://gitlab.com
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
# URL GitLab project hooks call; default {API_BASE_URL}/api/webhooks/gitlab (right for the Cloudflare tunnel). With smee set it to SMEE_GITLAB_URL
GITLAB_WEBHOOK_URL=
# dev only: smee channel for GitLab project hooks
SMEE_GITLAB_URL=

# --- LLM roles (any OpenAI-compatible provider)
LLM_REVIEW_BASE_URL=https://api.openai.com/v1
LLM_REVIEW_API_KEY=
LLM_REVIEW_MODEL=gpt-6-luna
LLM_REVIEW_PRICE_INPUT_PER_1M=0.10
LLM_REVIEW_PRICE_CACHED_PER_1M=0.01
LLM_REVIEW_PRICE_OUTPUT_PER_1M=0.50
LLM_CHEAP_BASE_URL=https://api.openai.com/v1
LLM_CHEAP_API_KEY=
LLM_CHEAP_MODEL=gpt-5-nano
LLM_CHEAP_PRICE_INPUT_PER_1M=0.05
LLM_CHEAP_PRICE_CACHED_PER_1M=0.005
LLM_CHEAP_PRICE_OUTPUT_PER_1M=0.40
LLM_EMBED_BASE_URL=https://api.openai.com/v1
LLM_EMBED_API_KEY=
LLM_EMBED_MODEL=text-embedding-3-small
LLM_EMBED_DIMENSIONS=1536
LLM_LOG_FULL=false
LLM_LOG_RETENTION_DAYS=30

# --- billing (Razorpay TEST MODE ONLY — the API refuses to start with a non rzp_test_ key)
RAZORPAY_KEY_ID=rzp_test_xxx
# billing stays disabled (503 billing_not_configured) until this is set
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_URL=https://api.razorpay.com/v1
# dev only: smee channel for Razorpay webhooks (optional; /verify works without)
SMEE_RAZORPAY_URL=
CREDITS_SIGNUP_BONUS=300
# Token-metered credits (docs/token-metered-billing.md): credits per 1M tokens per role.
CREDITS_REVIEW_INPUT_PER_1M=6000
CREDITS_REVIEW_CACHED_PER_1M=600
CREDITS_REVIEW_OUTPUT_PER_1M=12000
CREDITS_CHEAP_INPUT_PER_1M=2000
CREDITS_CHEAP_CACHED_PER_1M=200
CREDITS_CHEAP_OUTPUT_PER_1M=4000
CREDITS_EMBED_INPUT_PER_1M=200
CREDITS_EMBED_CACHED_PER_1M=200
CREDITS_EMBED_OUTPUT_PER_1M=0
# Holds: a review reserves base + lines*per_line + files*per_file (clamped to [min, max] and the
# balance), then settles at the credits actually used (rounded up to a whole credit); the rest is returned.
REVIEW_HOLD_BASE=100
REVIEW_HOLD_PER_LINE=0.4
REVIEW_HOLD_PER_FILE=5
REVIEW_HOLD_MAX=500
REVIEW_MIN_CHARGE=10
CHAT_HOLD_MAX=100
CHAT_MIN_CHARGE=5
FINISHING_HOLD_MAX=300
FINISHING_MIN_CHARGE=10
SECURITY_HOLD_MAX=500
SECURITY_MIN_CHARGE=50
# Display-only typical prices for the public pricing copy
CREDITS_TYPICAL_REVIEW=100
CREDITS_TYPICAL_CHAT_REPLY=50
CREDIT_PACK_CREDITS=200
CREDIT_PACK_PRICE_PAISE=9900
MAX_PURCHASES_PER_ORG=1
MAX_CREDIT_BALANCE=500
RATE_LIMIT_REVIEWS_PER_HOUR=2
RATE_LIMIT_CHAT_PER_HOUR=10

# --- review engine
REVIEW_WORKER_CONCURRENCY=1
REVIEW_MAX_FILES=150
REVIEW_MAX_CHANGED_LINES=5000
REVIEW_MAX_TASKS=6
REVIEW_MAX_COMMENTS=25
REVIEW_AGENT_PARALLELISM=1
# Reviews stuck in queued/running longer than this are failed and refunded (beat sweep)
REVIEW_STUCK_TIMEOUT_MINUTES=120
AGENT_MAX_STEPS=8
AGENT_MAX_INPUT_TOKENS=60000
GRAPH_MAX_FILES=3000
REPO_MAX_MB=300
SANDBOX_IMAGE=hootpr/sandbox:latest
SANDBOX_MEM_MB=768
SANDBOX_TEST_MEM_MB=1200
SANDBOX_CPUS=1.0
# docker (production) | local (tests/evals/dev only: runs repo commands on the HOST; refused when APP_ENV=production)
SANDBOX_BACKEND=docker
# Egress-only network attached while cloning, disconnected ("sealed") before analysis
SANDBOX_NETWORK=hootpr_sandbox_egress
SANDBOX_CLONE_DEPTH=50
# Timeouts for one run_tools.py / build_graph.py execution inside the sandbox
SANDBOX_TOOLS_TIMEOUT_S=600
SANDBOX_GRAPH_TIMEOUT_S=300
# Leftover sandbox containers older than this are removed by a beat task
SANDBOX_ORPHAN_MAX_AGE_MINUTES=30
# local backend only: path of sandbox/hootpr_tools (empty = this checkout's)
SANDBOX_LOCAL_TOOLS_DIR=
# Cap on code-graph symbols read into the worker (memory budget, spec §11.3)
GRAPH_MAX_SYMBOLS=20000
# Agent `shell` tool limits (spec §7.5)
AGENT_SHELL_TIMEOUT_S=20
AGENT_SHELL_MAX_OUTPUT_KB=16
# Cost bounds: AGENT_MAX_INPUT_TOKENS caps one prompt; these cap the input tokens summed over a
# task's calls, the findings one task may report, and the input tokens of a whole review
AGENT_MAX_TASK_INPUT_TOKENS=250000
AGENT_MAX_FINDINGS=15
REVIEW_MAX_INPUT_TOKENS=1500000
# Judge (spec §7.6): findings per LLM call (max 10) and keep thresholds per profile
JUDGE_BATCH_SIZE=10
JUDGE_MIN_CONFIDENCE_CHILL=0.6
JUDGE_MIN_CONFIDENCE_ASSERTIVE=0.45
# Code graph + tool results cache per (repo, sha), spec §11.4
REVIEW_CACHE_TTL_DAYS=7
# DOCKER_HOST is set by docker-compose.yml for api/worker (tcp://docker-proxy:2375). Do NOT set it
# here: `docker compose` reads DOCKER_HOST from .env and would try to reach the proxy from the host.
# DOCKER_HOST=tcp://docker-proxy:2375

# --- chat & knowledge (Phase 3)
# Chat agent (review role): investigative tool calls, prompt size, reply length, thread history
CHAT_AGENT_MAX_STEPS=6
CHAT_MAX_INPUT_TOKENS=40000
CHAT_REPLY_MAX_CHARS=4000
CHAT_THREAD_MAX_MESSAGES=10
# Chats still queued/running after this many minutes (lost broker message, dead worker) are
# failed and their chat hold released by the maintenance.sweep_stuck_chats beat (10 min).
CHAT_STUCK_TIMEOUT_MINUTES=30
# Learnings: top-k per review task, minimum cosine similarity, max learnings one chat reply may add
LEARNINGS_TOP_K=8
LEARNINGS_MIN_SIMILARITY=0.25
LEARNINGS_MAX_PER_CHAT=3
# Code guidelines (CLAUDE.md, AGENTS.md, .cursorrules, ...) read from the base branch
GUIDELINES_MAX_FILES=50
GUIDELINES_MAX_FILE_KB=8
GUIDELINES_MAX_TOTAL_KB=32
# AST-grep instructions (reviews.ast_grep_instructions / reviews.tools.ast_grep)
AST_GREP_TIMEOUT_S=120

# --- finishing touches (Phase 4): docstrings, unit tests, autofix, simplify, fix CI, merge conflicts
# Code-changing finishing touches hold up to FINISHING_HOLD_MAX credits and one review rate-limit
# slot (metered; charged only when a commit / stacked PR was delivered). CI failure analysis
# comments are metered like chat replies (CHAT_HOLD_MAX) and use one chat slot. Test runs use
# SANDBOX_TEST_MEM_MB.
FINISHING_AGENT_MAX_STEPS=24
FINISHING_MAX_INPUT_TOKENS=60000
FINISHING_MAX_TOTAL_INPUT_TOKENS=600000
# hard timeout of the dependency install and of each test run (seconds)
FINISHING_TEST_TIMEOUT_S=600
FINISHING_MAX_TEST_ITERATIONS=3
FINISHING_CLONE_DEPTH=500
FINISHING_MAX_FILES=60
FINISHING_MAX_FILE_KB=512
FINISHING_STUCK_TIMEOUT_MINUTES=60
CI_LOG_MAX_JOBS=5
CI_LOG_MAX_KB=24

# --- optional
# Ph7 knowledge base. web_search tool: SEARCH_PROVIDER = "" (off) | brave | http (generic JSON API)
SEARCH_PROVIDER=
SEARCH_API_URL=
SEARCH_API_KEY=
# Header carrying the key ("Authorization" sends "Bearer <key>"); brave defaults to X-Subscription-Token
SEARCH_API_KEY_HEADER=Authorization
SEARCH_QUERY_PARAM=q
# Dotted path to the results array in the JSON response (items need title/url/snippet-ish keys)
SEARCH_RESULTS_PATH=results
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_S=10
# Remote MCP servers (streamable HTTP only; calls run from the worker, SSRF-guarded)
MCP_TIMEOUT_S=20
MCP_MAX_OUTPUT_KB=16
MCP_MAX_SERVERS_PER_ORG=10
MCP_MAX_TOOLS=20
MCP_MAX_CALLS_PER_REVIEW=20
# Dev/test only (refused in production): allow http:// and private/loopback MCP hosts
MCP_ALLOW_HTTP=false
MCP_ALLOW_PRIVATE_HOSTS=false
# Linked repositories (knowledge_base.linked_repositories): max per review, max checkout size
LINKED_REPOS_MAX=5
LINKED_REPOS_MAX_MB=200
# Ph8 report emails: smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465
SMTP_URL=
REPORTS_EMAIL_FROM=HootPR <reports@hootpr.local>
# Ph8 analytics / reports / public API
REPORTS_CUSTOM_PER_DAY=5
REPORTS_MAX_OUTPUT_TOKENS=1500
PUBLIC_API_RATE_PER_MINUTE=60
EXPORT_MAX_ROWS=10000

# --- production (`make prod-up`; docker-compose.prod.yml — see README "Deploy")
# For production set APP_BASE_URL / API_BASE_URL / API_PUBLIC_URL above to your https domains
# (e.g. https://app.example.com and https://api.example.com), COOKIE_SAMESITE=lax and a strong
# POSTGRES_PASSWORD. APP_ENV=production is forced by docker-compose.prod.yml.
# nightly pg_dump hour (UTC) and retention
BACKUP_HOUR_UTC=3
BACKUP_KEEP_DAYS=7

# --- tests only (normally unset: backend tests start their own containers with testcontainers)
# TEST_DATABASE_URL=postgresql+psycopg://hootpr:hootpr@127.0.0.1:<port>/hootpr_test   # docker compose port postgres-test 5432
# TEST_REDIS_URL=redis://127.0.0.1:<port>/0                                          # docker compose port redis-test 6379

# --- pre/post-merge & issues (Phase 5)
# RELATED_PRS_MIN_SIMILARITY=0.8        # cosine similarity for "Possibly related PRs"
# ISSUE_DUPLICATE_MIN_SIMILARITY=0.85   # cosine similarity for possible duplicate issues
