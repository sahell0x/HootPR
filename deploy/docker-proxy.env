# tecnativa/docker-socket-proxy allowlist (spec §4.3): the worker may only manage containers,
# connect/disconnect networks and exec. Everything else (images, build, volumes, swarm, system...) is denied.
CONTAINERS=1
NETWORKS=1
EXEC=1
POST=1
PING=1
VERSION=1
ALLOW_START=1
ALLOW_STOP=1
ALLOW_RESTARTS=0
EVENTS=0
AUTH=0
BUILD=0
COMMIT=0
CONFIGS=0
DISTRIBUTION=0
GRPC=0
IMAGES=0
INFO=0
NODES=0
PLUGINS=0
SECRETS=0
SERVICES=0
SESSION=0
SWARM=0
SYSTEM=0
TASKS=0
VOLUMES=0
LOG_LEVEL=warning
